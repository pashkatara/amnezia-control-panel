{% extends "layout.twig" %}

{% block title %}Регистрация — {{ app_name }}{% endblock %}

{% block content %}
<div class="min-h-screen -mt-0 flex items-center justify-center gradient-bg py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Decorative background glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full space-y-8 relative z-10">
        <div class="text-center">
            <div class="mx-auto w-16 h-16 rounded-2xl brand-gradient flex items-center justify-center shadow-xl shadow-indigo-500/25 mb-4 transform hover:scale-105 transition-transform">
                <i class="fas fa-user-plus text-white text-2xl"></i>
            </div>
            <h2 class="text-3xl font-extrabold text-white tracking-tight">
                Создание аккаунта
            </h2>
            <p class="mt-2 text-sm text-slate-300">
                Зарегистрируйтесь для доступа к панели управления
            </p>
        </div>
        
        <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/20 p-8">
            {% if error %}
            <div class="mb-6 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-sm flex items-start gap-3" role="alert">
                <i class="fas fa-exclamation-circle text-rose-500 mt-0.5 text-base"></i>
                <div>
                    <span class="font-medium">Ошибка:</span> {{ error }}
                </div>
            </div>
            {% endif %}

            <form class="space-y-5" method="POST" action="/register">
                <div>
                    <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">Полное имя</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="fas fa-user"></i>
                        </div>
                        <input id="name" name="name" type="text" required
                               class="block w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition"
                               placeholder="Иван Иванов">
                    </div>
                </div>

                <div>
                    <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email адрес</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <input id="email" name="email" type="email" required
                               class="block w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition"
                               placeholder="user@example.com">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-sm font-semibold text-slate-700 mb-1.5">Пароль</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="fas fa-lock"></i>
                        </div>
                        <input id="password" name="password" type="password" required
                               class="block w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition"
                               placeholder="••••••••">
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">Минимум 6 символов</p>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center items-center py-2.5 px-4 rounded-xl shadow-lg shadow-indigo-500/25 text-sm font-semibold text-white brand-gradient hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150">
                        <i class="fas fa-user-plus mr-2"></i>
                        Зарегистрироваться
                    </button>
                </div>

                <div class="text-center text-sm pt-2">
                    <a href="/login" class="text-indigo-600 hover:text-indigo-700 font-medium">
                        Уже есть аккаунт? Войти
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
