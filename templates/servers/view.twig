async function updateServerMetrics() {
  try {
    const response = await fetch(`/api/servers/${serverId}/metrics?hours=1`, {
      credentials: 'same-origin'
    });
    
    const data = await response.json();
    
    if (data.success && data.metrics && data.metrics.length > 0) {
      const latest = data.metrics[data.metrics.length - 1];
      
      const cpuVal = parseFloat(latest.cpu_percent).toFixed(1);
      const cpuEl = document.getElementById('cpuValue');
      if (cpuEl) cpuEl.textContent = `${cpuVal}%`;
      
      const ramPercent = Math.round(latest.ram_used_mb / latest.ram_total_mb * 100);
      const ramEl = document.getElementById('ramValue');
      if (ramEl) ramEl.textContent = `${ramPercent}%`;
      
      const diskPercent = Math.round(latest.disk_used_gb / latest.disk_total_gb * 100);
      const diskEl = document.getElementById('diskValue');
      if (diskEl) diskEl.textContent = `${diskPercent}%`;
      
      const netRx = parseFloat(latest.network_rx_mbps).toFixed(1);
      const netTx = parseFloat(latest.network_tx_mbps).toFixed(1);
      const netEl = document.getElementById('networkValue');
      if (netEl) netEl.textContent = `↓${netRx} ↑${netTx}`;
    }
  } catch (error) {
    console.error('Failed to fetch server metrics:', error);
  }
}

// Live Real-Time Client Polling Engine (Traffic, Speed, Online Status, Handshake)
async function updateClientsLive() {
  try {
    const response = await fetch(`/api/servers/${serverId}/clients`, {
      credentials: 'same-origin'
    });
    if (!response.ok) return;
    const data = await response.json();
    if (!data.success || !data.clients) return;

    data.clients.forEach(c => {
      const row = document.querySelector(`tr[data-client-id="${c.id}"]`);
      if (!row) return;

      // 1. Update Status Pill
      const pill = row.querySelector('.status-pill-container');
      const isOnline = c.stats && c.stats.is_online;
      if (pill) {
        if (isOnline) {
          pill.innerHTML = '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Онлайн</span>';
        } else if (c.status === 'active') {
          pill.innerHTML = '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Не в сети</span>';
        } else {
          pill.innerHTML = '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>{{ t("status.disabled") }}</span>';
        }
      }

      // 2. Update Handshake Time
      const hs = row.querySelector('.handshake-time');
      if (hs) {
        hs.textContent = c.last_handshake ? c.last_handshake : '{{ t("clients.never") }}';
      }

      // 3. Update Traffic Received & Sent
      const recEl = row.querySelector('.traffic-rec-val');
      if (recEl) {
        recEl.textContent = (c.bytes_received / 1048576).toFixed(1);
      }
      const sentEl = row.querySelector('.traffic-sent-val');
      if (sentEl) {
        sentEl.textContent = (c.bytes_sent / 1048576).toFixed(1);
      }

      // 4. Update Speeds
      const speedDownEl = row.querySelector('.speed-down-val');
      if (speedDownEl) {
        speedDownEl.textContent = ((c.speed_down * 8) / 1000000).toFixed(1);
      }
      const speedUpEl = row.querySelector('.speed-up-val');
      if (speedUpEl) {
        speedUpEl.textContent = ((c.speed_up * 8) / 1000000).toFixed(1);
      }

      // 5. Update avatar online pulse dot
      const dot = row.querySelector('.online-pulse-dot');
      if (dot) {
        if (isOnline) {
          dot.classList.remove('hidden');
        } else {
          dot.classList.add('hidden');
        }
      }
    });
  } catch (e) {
    console.error('Failed to update live clients:', e);
  }
}

// Quick rename client from table
async function quickRenameClient(clientId, currentName) {
  const newName = prompt('Введите имя клиента:', currentName);
  if (!newName || newName.trim() === '' || newName === currentName) return;
  try {
    const res = await fetch(`/clients/${clientId}/rename`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: newName.trim() })
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert('Ошибка: ' + (data.error || 'Не удалось переименовать'));
    }
  } catch (e) {
    alert('Ошибка сети: ' + e.message);
  }
}

// Initial load & Polling Loops
document.addEventListener('DOMContentLoaded', function() {
  updateServerMetrics();
  updateClientsLive();
  setInterval(updateServerMetrics, 10000); // Live Server Metrics every 10s
  setInterval(updateClientsLive, 5000);    // Live Client Traffic & Speeds every 5s
});
